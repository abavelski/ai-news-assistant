# Runtime
LOG_LEVEL=info

# Storage and delivery
DATA_DIR=./data
OUTPUT_DIR=./data/public/daily
HOST=0.0.0.0
PORT=8787
EDITION_RETENTION_DAYS=30
BUILD_RETENTION_DAYS=7

# Edition settings
LOOKBACK_HOURS=24
MAX_ARTICLES=50
EDITION_MAX_ARTICLES=10
EDITORIAL_MAX_PER_TOPIC=3
EDITION_LANGUAGE=ru
INCLUDE_FULL_ARTICLES=true

# Meduza
MEDUZA_RSS_URL=https://meduza.io/rss/all
HTTP_USER_AGENT="ai-news-assistant/0.1 (+personal self-hosted reader)"
HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=2
HTTP_RETRY_BASE_DELAY_MS=500
ARTICLE_FETCH_DELAY_MS=250
MIN_ARTICLE_CHARS=200

# OpenAI-compatible LLM endpoint.
# OpenAI examples: gpt-4.1-mini and gpt-5-mini at https://api.openai.com
# Local server example: http://127.0.0.1:11434
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
LLM_API_KEY=
# Conventional models use this sampling value. GPT-5-family Chat Completions omit it for compatibility.
LLM_TEMPERATURE=0.2
# Sent as max_tokens for conventional models and max_completion_tokens for GPT-5-family models.
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=120000
LLM_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=500
LLM_ARTICLE_MAX_CHARS=28000
