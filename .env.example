# Runtime
LOG_LEVEL=info

# Storage and delivery
DATA_DIR=./data
OUTPUT_DIR=./data/public/daily
HOST=0.0.0.0
PORT=8787
# Docker Compose publishes the fixed container port 8787 using these host-side settings.
AI_NEWS_BIND_ADDRESS=0.0.0.0
AI_NEWS_HTTP_PORT=8787
# Docker image selected by Compose. On the home server use an immutable Git-SHA tag loaded with docker load.
AI_NEWS_IMAGE=ai-news-assistant:local
# Used by the home-lab Compose override as the host-visible persistent data directory.
AI_NEWS_DATA_DIR=/var/lib/ai-news-assistant
EDITION_RETENTION_DAYS=30
BUILD_RETENTION_DAYS=7

# Edition settings
LOOKBACK_HOURS=24
MAX_ARTICLES=50
EDITION_MAX_ARTICLES=10
EDITORIAL_MAX_PER_TOPIC=3
# Maximum selected items from one source instance; default matches EDITION_MAX_ARTICLES.
EDITORIAL_MAX_PER_SOURCE=10
# Maximum Reddit/discussion items selected across all source instances.
EDITORIAL_MAX_DISCUSSIONS=3
EDITION_LANGUAGE=ru
INCLUDE_FULL_ARTICLES=true

# Meduza bootstrap compatibility. On a fresh source store this seeds the persisted `meduza` source.
# After bootstrap, the source row in SQLite is authoritative.
MEDUZA_RSS_URL=https://meduza.io/rss/all
HTTP_USER_AGENT="ai-news-assistant/0.1 (+personal self-hosted reader)"
HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=2
HTTP_RETRY_BASE_DELAY_MS=500
ARTICLE_FETCH_DELAY_MS=250
MIN_ARTICLE_CHARS=200

# Reddit OAuth Data API. These credentials are required only when at least one Reddit source is enabled.
# Create/register a Reddit API client for this personal deployment and keep the secret only in this protected environment file.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Use a unique descriptive User-Agent identifying the app/version and your Reddit username.
REDDIT_USER_AGENT="linux:ai-news-assistant:0.1 (by /u/your_reddit_username)"
REDDIT_HTTP_TIMEOUT_MS=20000
REDDIT_HTTP_RETRIES=2
REDDIT_RETRY_BASE_DELAY_MS=500
# Bound API payloads, server-directed waiting, and total Reddit thread materializations across all subreddits per run.
REDDIT_MAX_RESPONSE_BYTES=2000000
REDDIT_MAX_RATE_LIMIT_WAIT_MS=60000
REDDIT_MAX_TOTAL_CANDIDATES=20
# Reddit discussion content defaults to a local/private LLM endpoint. For an external/cloud LLM, explicitly set
# external-acknowledged only after reviewing current Reddit API/developer terms and accepting that processing boundary.
REDDIT_LLM_TRUST_BOUNDARY=local

# OpenAI-compatible LLM endpoint.
# OpenAI examples: gpt-4.1-mini and gpt-5-mini at https://api.openai.com
# Local development server example: http://127.0.0.1:11434
# Home-lab LAN LLM example: http://gaming-rig.home.arpa:11434
# Same-Docker-host fallback supported by the base Compose file: http://host.docker.internal:11434
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
LLM_API_KEY=
# Conventional models use this sampling value. GPT-5-family Chat Completions omit it for compatibility.
LLM_TEMPERATURE=0.2
# Sent as max_tokens for conventional models and max_completion_tokens for GPT-5-family models.
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=120000
LLM_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=500
LLM_ARTICLE_MAX_CHARS=28000
