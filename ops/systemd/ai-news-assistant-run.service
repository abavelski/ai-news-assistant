[Unit]
Description=AI News Assistant morning edition generation in Docker
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-news-assistant
ExecStart=/usr/bin/docker compose --env-file /opt/ai-news-assistant/.env -f /opt/ai-news-assistant/compose.yaml -f /opt/ai-news-assistant/ops/homelab/compose.yaml run --rm --pull never app run
TimeoutStartSec=45min
