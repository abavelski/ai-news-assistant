[Unit]
Description=AI News Assistant Docker delivery service
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-news-assistant
ExecStart=/usr/bin/docker compose --env-file /opt/ai-news-assistant/.env -f /opt/ai-news-assistant/compose.yaml -f /opt/ai-news-assistant/ops/homelab/compose.yaml up -d --no-build app
ExecReload=/usr/bin/docker compose --env-file /opt/ai-news-assistant/.env -f /opt/ai-news-assistant/compose.yaml -f /opt/ai-news-assistant/ops/homelab/compose.yaml up -d --no-build app
ExecStop=/usr/bin/docker compose --env-file /opt/ai-news-assistant/.env -f /opt/ai-news-assistant/compose.yaml -f /opt/ai-news-assistant/ops/homelab/compose.yaml stop app
TimeoutStartSec=5min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
